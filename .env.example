# ──────────────────────────────────────────────
# PDFForge — Environment Variables
# Copy this file to .env.local and fill in values.
# Core PDF tools work WITHOUT any env vars (client-side only).
# ──────────────────────────────────────────────

# ── Site ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── Auth (optional) ──────────────────────────
# Enable authentication (Clerk or Better Auth)
AUTH_SECRET=
AUTH_PROVIDER=clerk

# Clerk (if using Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database (optional) ──────────────────────
# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://user:password@host:5432/pdfforge

# ── Billing (optional) ───────────────────────
# Enable paid plans with Stripe, LemonSqueezy or Paddle
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# ── Storage (optional) ───────────────────────
# Server-side file storage (Vercel Blob, S3, etc.)
BLOB_READ_WRITE_TOKEN=
STORAGE_PROVIDER=vercel-blob

# ── AI (optional) ────────────────────────────
# LLM API key for AI-powered tools (summarize, translate, etc.)
USER_LLM_API_KEY=
USER_LLM_PROVIDER=openai

# ── OCR (optional) ───────────────────────────
# Tesseract or custom OCR service URL
OCR_SERVICE_URL=

# ── Queue (optional) ─────────────────────────
# Redis URL for BullMQ job queue (server-side conversions)
REDIS_URL=

# ── Email (optional) ─────────────────────────
# Resend API key for transactional emails
RESEND_API_KEY=

# ── Analytics (optional) ─────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# ── Error Tracking (optional) ────────────────
SENTRY_DSN=
